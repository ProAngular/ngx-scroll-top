{
  "name": "@proangular/ngx-scroll-top",
  "version": "22.0.0",
  "description": "Configurable, lightweight back to top button for Angular projects.",
  "author": "Pro Angular <webmaster@proangular.com>",
  "homepage": "https://www.proangular.com",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "lint": "ng lint",
    "ng": "ng",
    "npm-build-package": "ng-packagr -p ng-package.json",
    "postinstall": "is-ci || husky",
    "prettier": "prettier --write . --log-level silent",
    "prettier:check": "prettier --check .",
    "start": "ng serve --open",
    "test": "ng test",
    "update": "ncu -u",
    "update:check": "ncu",
    "watch": "ng build --watch --configuration development"
  },
  "peerDependencies": {
    "@angular/common": ">=22 <23",
    "@angular/core": ">=22 <23"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cdk": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/jasmine": "~5.1.8",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24",
    "angular-eslint": "^22.7.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "ng-packagr": "^22.2.6",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.10.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2"
  },
  "contributors": [
    {
      "name": "Cody Tolene",
      "email": "webmaster@codytolene.com",
      "url": "https://www.codytolene.com"
    }
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProAngular/ngx-scroll-top.git"
  },
  "keywords": [
    "pro",
    "angular",
    "scroll",
    "top",
    "ngx-scroll-top",
    "scroll-top",
    "scroll to top",
    "ngx",
    "animate",
    "button"
  ],
  "bugs": {
    "url": "https://github.com/ProAngular/ngx-scroll-top/issues"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/proangular"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "src/main.ts",
  "allowScripts": {
    "esbuild@0.28.2": true
  }
